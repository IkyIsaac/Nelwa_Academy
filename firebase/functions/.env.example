# Copy to .env (gitignored) and fill in before deploying.
# Firebase Functions loads .env automatically at deploy/runtime.

# Snippe dashboard -> API keys.
SNIPPE_API_KEY=

# Snippe dashboard -> Settings -> Webhook Secret (or GET /api/v1/settings/webhook-secret).
SNIPPE_WEBHOOK_SECRET=

# The deployed URL of the snippeWebhook function below, e.g.
# https://us-central1-nelwasacademy-7uw9xf.cloudfunctions.net/snippeWebhook
# Deploy once to learn the URL, then set this and redeploy.
SNIPPE_WEBHOOK_URL=

# Only needed if Snippe gives you a different base URL for sandbox/test keys.
# SNIPPE_BASE_URL=https://api.snippe.sh
