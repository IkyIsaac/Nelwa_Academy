rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
          request.auth.token.email == 'isaackitomari33@gmail.com';
    }

    match /users/{document} {
      allow create: if false;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if false;
    }

    match /users/{parent}/payment_account/{document} {
      allow create: if false;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if false;
    }

    match /{path=**}/payment_account/{document} {
      allow read: if request.auth != null;
    }


    match /users/{parent}/payment_method/{document} {
      allow create: if false;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if false;
    }

    match /{path=**}/payment_method/{document} {
      allow read: if request.auth != null;
    }


    match /support/{document} {
      allow create: if false;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if false;
    }

    match /support/{parent}/support_message/{document} {
      allow create: if false;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if false;
    }

    match /{path=**}/support_message/{document} {
      allow read: if request.auth != null;
    }


    match /courses/{document} {
      allow create: if false;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if false;
    }

    match /courses/{parent}/lessons/{document} {
      allow create: if false;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if false;
    }

    match /{path=**}/lessons/{document} {
      allow read: if request.auth != null;
    }


    match /users/{parent}/instructor_details/{document} {
      allow create: if false;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if false;
    }

    match /{path=**}/instructor_details/{document} {
      allow read: if request.auth != null;
    }


    match /users/{parent}/notification/{document} {
      allow create: if false;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if false;
    }

    match /{path=**}/notification/{document} {
      allow read: if request.auth != null;
    }


    match /courses/{parent}/courses_review/{document} {
      allow create: if false;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if false;
    }

    match /{path=**}/courses_review/{document} {
      allow read: if request.auth != null;
    }


    match /courses/{parent}/review_report/{document} {
      allow create: if false;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if false;
    }

    match /{path=**}/review_report/{document} {
      allow read: if request.auth != null;
    }


    match /courses/{parent}/lesson_report/{document} {
      allow create: if false;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if false;
    }

    match /{path=**}/lesson_report/{document} {
      allow read: if request.auth != null;
    }


    match /users/{parent}/purchase_history/{document} {
      allow create: if false;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if false;
    }

    match /{path=**}/purchase_history/{document} {
      allow read: if request.auth != null;
    }


    match /users/{parent}/purchased_courses/{document} {
      // Entitlements are granted only by the snippeWebhook Cloud Function
      // (Admin SDK, bypasses these rules) once a payment is confirmed.
      // Clients may still update their own progress fields
      // (watched_lessons, reviwed) on an existing purchase.
      allow create: if false;
      allow read: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    match /{path=**}/purchased_courses/{document} {
      allow read: if request.auth != null;
    }


    match /options/{document} {
      allow create: if false;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if false;
    }

    match /ads/{document} {
      allow create: if true;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if false;
    }

    match /requesta_refund/{document} {
      allow create: if false;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if false;
    }

    match /users/{parent}/user_reviews/{document} {
      allow create: if false;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if false;
    }

    match /{path=**}/user_reviews/{document} {
      allow read: if request.auth != null;
    }


    match /courses/{parent}/courses_report/{document} {
      allow create: if false;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if false;
    }

    match /{path=**}/courses_report/{document} {
      allow read: if request.auth != null;
    }


    match /consultation/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    // Orders are created and fulfilled only by Cloud Functions (Admin SDK,
    // bypasses these rules). Clients may only read their own order, to watch
    // its status while a Snippe checkout is in progress.
    match /orders/{document} {
      allow read: if (request.auth != null && request.auth.uid == resource.data.userId) || isAdmin();
      allow write: if false;
    }

    // Payouts are created and fulfilled only by Cloud Functions (Admin SDK,
    // bypasses these rules). The instructor can read their own, the admin
    // can read all; no client ever writes one.
    match /payouts/{document} {
      allow read: if (request.auth != null && request.auth.uid == resource.data.instructorUserId) || isAdmin();
      allow write: if false;
    }
  }
}
